# Copy to .env (or set the same names on Vercel)

# Supabase: Project Settings → API (the anon / publishable key is meant to be public; row level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI: date ideas from GPT-5.2 (/api/ai). Without it the AI buttons do not appear.
OPENAI_API_KEY=
# Optional: another model (default gpt-5.2) and how hard it thinks (none / low / medium / high / xhigh; default low)
AI_MODEL=
AI_EFFORT=
